# Example .env file for live trading (DO NOT commit real keys to the repository)

# Set to true to actually send orders. Default is false (dry-run mode):
# LIVE_TRADING=true

# Exchange-specific keys (example names: BINANCE_API_KEY, BINANCE_API_SECRET)
# BINANCE_API_KEY=your_api_key_here
# BINANCE_API_SECRET=your_api_secret_here

# Optional defaults used by the CLI
# PRICE_TICK=0.01
# AMOUNT_TICK=0.000001
# ORDER_LOG_PATH=live_orders.log
